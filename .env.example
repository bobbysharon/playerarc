# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# CHANGE THIS. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
# SQLite file (swap DB_CLIENT=pg + DATABASE_URL for Postgres in production)
DATABASE_FILE=./data/playerarc.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Seed control
SEED_DEMO=true
