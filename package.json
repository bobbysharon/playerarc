{
  "name": "playerarc",
  "version": "1.0.0",
  "private": true,
  "description": "PlayerArc \u2014 Athlete Records & Performance Management Platform for Karwan Sports Club",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "db:reset": "npm run reset --workspace server",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "demo:data": "node scripts/export-demo-data.mjs && node scripts/build-demo-engine.mjs",
    "build:demo": "npm run build:demo --workspace web",
    "preview:demo": "npm run preview --workspace web",
    "build:pages": "npm run build:demo && node scripts/publish-docs.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}